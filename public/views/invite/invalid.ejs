<!DOCTYPE html>
<html lang="<%= getLocale() %>">

<head>
    <%- include('../index/head') %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,900;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style nonce="<%= nonce %>">
        :root {
            --paper: #f7f4ee; --paper-raised: #fffefb; --ink: #1d1b18; --ink-soft: #574f46; --ink-faint: #948b7d;
            --rule-strong: #d2c9b9; --accent: #c2412a; --accent-deep: #a2331f; --accent-tint: #f5e6e0;
        }
        html, body, .site-wrapper, .site-wrapper-inner { background: var(--paper) !important; color: var(--ink); }
        body { font-family: 'Hanken Grotesk', system-ui, sans-serif; }
        .cover-container { max-width: 460px; }
        .inner.cover { text-align: left; }
        .invite-mark { font-family: 'Fraunces', Georgia, serif; font-weight: 900; color: var(--ink); font-size: clamp(44px, 9vw, 68px); line-height: .92; letter-spacing: -.02em; margin: 0; }
        .invite-mark .fa { color: var(--accent); font-size: .7em; }
        .invite-rule { height: 3px; width: 64px; background: var(--accent); border: 0; margin: 18px 0 22px; }
        .invite-msg { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 22px; line-height: 1.3; color: var(--ink); }
        .invite-msg .fa { color: var(--accent); }
        .invite-sub { color: var(--ink-soft); margin-top: 8px; }
        .btn-invite { display: inline-block; background: var(--accent); border: 0; border-radius: 3px; color: #fff; font-weight: 600; letter-spacing: .02em; padding: 12px 28px; margin-top: 22px; transition: background .15s ease; }
        .btn-invite:hover, .btn-invite:focus { background: var(--accent-deep); color: #fff; text-decoration: none; }
        @keyframes invIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
        .inner.cover > * { animation: invIn .55s cubic-bezier(.22,.61,.36,1) both; }
        .invite-rule { animation-delay: .06s; } .invite-msg { animation-delay: .1s; } .invite-sub { animation-delay: .16s; } .btn-invite { animation-delay: .22s; }
        @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }
    </style>
</head>

<body>
    <div class="site-wrapper">
        <div class="site-wrapper-inner">
            <div class="cover-container">
                <div class="inner cover" style="margin-top: 12vh;">
                    <h1 class="invite-mark"><i class="fa fa-file-text"></i> CodiMD</h1>
                    <hr class="invite-rule">
                    <p class="invite-msg"><i class="fa fa-exclamation-triangle"></i> <%= __('This invite link is invalid or has expired.') %></p>
                    <p class="invite-sub"><%= __('Ask an admin for a new one.') %></p>
                    <a href="<%- serverURL %>/" class="btn-invite"><%= __('Go to sign in') %></a>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
