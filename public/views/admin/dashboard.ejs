<!DOCTYPE html>
<html lang="<%= getLocale() %>">

<head>
    <%- include('../index/head') %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style nonce="<%= nonce %>">
        :root {
            --paper: #f5f1e8; --paper-raised: #fffdf7; --ink: #221d17; --ink-soft: #5f564a; --ink-faint: #938876;
            --rule: #e2dac9; --rule-strong: #cfc4b0; --accent: #a23a26; --accent-deep: #7f2c1c; --accent-tint: #f1e4dd;
            --sage: #3d6a4d; --sage-tint: #e7efe7; --ochre: #946614; --tag: #33506f;
        }
        body { background-color: var(--paper); color: var(--ink); font-family: 'Hanken Grotesk', system-ui, -apple-system, sans-serif; }
        ::selection { background: var(--accent-tint); }
        .admin-wrap { max-width: 1060px; margin: 0 auto; padding: 36px 24px 80px; }
        .admin-head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 0; }
        .admin-head .brand { font-family: 'Fraunces', Georgia, serif; font-weight: 900; font-size: clamp(28px, 4.4vw, 44px); line-height: .92; letter-spacing: -.015em; color: var(--ink); }
        .admin-head .brand .fa { color: var(--accent); margin-right: 4px; font-size: .78em; }
        .admin-head .brand small { display: block; font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 500; font-size: .4em; color: var(--ink-soft); margin-top: 6px; }
        .admin-head .head-tools { color: var(--ink-soft); }
        .admin-head .head-tools .btn { color: var(--ink-soft); }
        .masthead-rule { height: 3px; background: var(--accent); margin: 16px 0 30px; border: 0; }
        .admin-panel { margin-bottom: 26px; background: var(--paper-raised); border: 1px solid var(--rule); border-radius: 3px; box-shadow: none; }
        .admin-panel > .panel-heading { background: transparent; border: 0; border-bottom: 1px solid var(--rule); color: var(--ink-faint); font-weight: 600; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; padding: 13px 16px; }
        .admin-panel > .panel-heading .fa { color: var(--accent); }
        .admin-panel > .panel-heading .badge { background: var(--accent); }
        .admin-panel .panel-body { padding: 16px; }
        .admin-panel .table { margin-bottom: 0; color: var(--ink); }
        .admin-panel .table > thead > tr > th { border-bottom: 1px solid var(--rule); color: var(--ink-faint); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; }
        .admin-panel .table > tbody > tr > td { border-top-color: var(--rule); }
        .admin-panel .table-striped > tbody > tr:nth-of-type(odd) { background: color-mix(in srgb, var(--accent-tint) 32%, transparent); }
        .admin-panel td { vertical-align: middle !important; }
        .invite-link { font-size: 12px; word-break: break-all; color: var(--accent-deep); }
        .row-actions form { display: inline-block; margin: 0 2px 2px 0; vertical-align: middle; }
        .reset-form { margin-top: 8px; max-width: 280px; }
        .btn-default { background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 3px; }
        .btn-default:hover, .btn-default:focus { background: var(--accent-tint); color: var(--accent-deep); border-color: var(--accent); }
        .btn-success { background: var(--sage); border-color: var(--sage); }
        .btn-danger { background: var(--accent); border-color: var(--accent); }
        .btn-warning { background: var(--ochre); border-color: var(--ochre); color: #fff; }
        .form-control { background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 3px; box-shadow: none; }
        .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-tint); }
        .help-block { color: var(--ink-faint); }
        a { color: var(--accent); } a:hover { color: var(--accent-deep); }
        .label-danger { background: var(--accent); }
        .label-info { background: var(--tag); }
        .label-default { background: var(--ink-soft); }
        .text-success { color: var(--sage) !important; }
        .alert-success { background: var(--sage-tint); border-color: color-mix(in srgb, var(--sage) 30%, transparent); color: var(--sage); }
        .alert-danger { background: var(--accent-tint); border-color: color-mix(in srgb, var(--accent) 30%, transparent); color: var(--accent-deep); }
        @keyframes adRise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
        .admin-head, .admin-panel { animation: adRise .5s cubic-bezier(.22,.61,.36,1) both; }
        .admin-panel:nth-of-type(2) { animation-delay: .06s; } .admin-panel:nth-of-type(3) { animation-delay: .12s; } .admin-panel:nth-of-type(4) { animation-delay: .18s; }
        body.dash-night {
            --paper: #1b1714; --paper-raised: #241f1a; --ink: #efe7da; --ink-soft: #b6ac9b; --ink-faint: #8a7f6d;
            --rule: #352e26; --rule-strong: #473e33; --accent: #d9694e; --accent-deep: #c2553c; --accent-tint: #2c211b;
            --sage: #7fb88f; --sage-tint: #1f2c23; --ochre: #d6a24e; --tag: #9db8d6;
            background-color: var(--paper); color: var(--ink);
        }
        body.dash-night .btn-danger, body.dash-night .btn-warning { color: #1b1714; }
        body.dash-night .close { color: var(--ink-soft); text-shadow: none; }
        @media (max-width: 768px) {
            .admin-wrap { padding: 16px 10px 50px; }
            .admin-head .brand small { display: none; }
            .admin-panel .table { min-width: 560px; }
            .reset-form { max-width: 100%; }
        }
        @media (prefers-reduced-motion: reduce) { *, .admin-head, .admin-panel { animation: none !important; transition: none !important; } }
    </style>
</head>

<body>
    <div class="admin-wrap">
        <div class="admin-head">
            <span class="brand"><i class="fa fa-file-text"></i>CodiMD <small><%= __('Admin') %></small></span>
            <span class="head-tools">
                <i class="fa fa-user-circle-o"></i> <%= me.email %>&ensp;
                <a href="<%- serverURL %>/" class="btn btn-sm btn-default"><i class="fa fa-home"></i> <%= __('Home') %></a>
                <a href="<%- serverURL %>/logout" class="btn btn-sm btn-default"><i class="fa fa-sign-out"></i> <%= __('Sign Out') %></a>
            </span>
        </div>
        <hr class="masthead-rule">

        <% errorMessages.forEach(function (m) { %>
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> <%= m %></div>
        <% }) %>
        <% infoMessages.forEach(function (m) { %>
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> <%= m %></div>
        <% }) %>

        <div class="panel panel-default admin-panel">
            <div class="panel-heading"><i class="fa fa-ticket"></i> <%= __('Create invite') %></div>
            <div class="panel-body">
                <form method="post" action="<%- serverURL %>/admin/invites" class="form-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="form-group">
                        <label><%= __('Max uses') %></label>
                        <input type="number" name="maxUses" class="form-control" min="1" value="1" style="width: 90px;">
                    </div>
                    <div class="form-group">
                        <label><%= __('Expires in (days)') %></label>
                        <input type="number" name="expiresInDays" class="form-control" min="1" value="7" style="width: 90px;">
                    </div>
                    <button type="submit" class="btn btn-success"><i class="fa fa-plus"></i> <%= __('Create invite') %></button>
                </form>
                <p class="help-block" style="margin: 10px 0 0;"><%= __('Share a reusable link for a whole class, or a single-use link for one person.') %></p>
            </div>
        </div>

        <div class="panel panel-default admin-panel">
            <div class="panel-heading"><i class="fa fa-link"></i> <%= __('Active invites') %> <span class="badge"><%= invites.length %></span></div>
            <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr><th><%= __('Role') %></th><th><%= __('Uses') %></th><th><%= __('Expires') %></th><th><%= __('Link') %></th><th></th></tr>
                </thead>
                <tbody>
                    <% if (invites.length === 0) { %>
                    <tr><td colspan="5" class="text-center text-muted" style="padding: 18px;"><%= __('No active invites yet.') %></td></tr>
                    <% } %>
                    <% invites.forEach(function (i) { %>
                    <tr>
                        <td><span class="label label-<%= i.role === 'owner' ? 'danger' : (i.role === 'admin' ? 'info' : 'default') %>"><%= i.role %></span></td>
                        <td><%= i.usedCount %> / <%= i.maxUses %></td>
                        <td><%= new Date(i.expiresAt).toISOString().slice(0, 10) %></td>
                        <td><code class="invite-link"><%- serverURL %>/invite/<%= i.token %></code></td>
                        <td class="text-right row-actions">
                            <form method="post" action="<%- serverURL %>/admin/invites/<%= i.id %>/revoke" data-confirm="<%= __('Revoke this invite?') %>">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-xs btn-danger"><i class="fa fa-times"></i> <%= __('Revoke') %></button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            </div>
        </div>

        <div class="panel panel-default admin-panel">
            <div class="panel-heading"><i class="fa fa-users"></i> <%= __('Members') %> <span class="badge"><%= users.length %></span></div>
            <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr><th><%= __('E-Mail') %></th><th><%= __('Role') %></th><th><%= __('Status') %></th><th><%= __('Joined') %></th><th class="text-right"><%= __('Actions') %></th></tr>
                </thead>
                <tbody>
                    <% users.forEach(function (u) { var isSelf = me && String(me.id) === String(u.id) %>
                    <tr>
                        <td><%= u.email || __('(external account)') %><% if (isSelf) { %> <span class="label label-info"><%= __('you') %></span><% } %></td>
                        <td><span class="label label-<%= u.role === 'owner' ? 'danger' : (u.role === 'admin' ? 'info' : 'default') %>"><%= u.role %></span></td>
                        <td>
                            <% if (u.active) { %><span class="text-success"><i class="fa fa-check-circle"></i> <%= __('active') %></span>
                            <% } else { %><span class="text-muted"><i class="fa fa-ban"></i> <%= __('deactivated') %></span><% } %>
                        </td>
                        <td><%= new Date(u.createdAt).toISOString().slice(0, 10) %></td>
                        <td class="text-right row-actions">
                            <% if (me.role === 'owner') { %>
                            <form method="post" action="<%- serverURL %>/admin/users/<%= u.id %>/role" class="form-inline"<% if (isSelf) { %> data-confirm="<%= __('Change your own role?') %>"<% } %>>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <select name="role" class="form-control input-sm" style="width: auto;">
                                    <option value="user"<% if (u.role === 'user') { %> selected<% } %>><%= __('User') %></option>
                                    <option value="admin"<% if (u.role === 'admin') { %> selected<% } %>><%= __('Admin') %></option>
                                    <option value="owner"<% if (u.role === 'owner') { %> selected<% } %>><%= __('Owner') %></option>
                                </select>
                                <button type="submit" class="btn btn-xs btn-default"><%= __('Set role') %></button>
                            </form>
                            <% } %>
                            <% if (u.active) { %>
                            <form method="post" action="<%- serverURL %>/admin/users/<%= u.id %>/deactivate"<% if (isSelf) { %> data-confirm="<%= __('Deactivate your own account?') %>"<% } %>>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-xs btn-warning"><i class="fa fa-ban"></i> <%= __('Deactivate') %></button>
                            </form>
                            <% } else { %>
                            <form method="post" action="<%- serverURL %>/admin/users/<%= u.id %>/activate">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-xs btn-success"><i class="fa fa-check"></i> <%= __('Activate') %></button>
                            </form>
                            <% } %>
                            <button type="button" class="btn btn-xs btn-default" data-reset-toggle="reset-<%= u.id %>"><i class="fa fa-key"></i></button>
                            <form method="post" action="<%- serverURL %>/admin/users/<%= u.id %>/reset-password" id="reset-<%= u.id %>" class="reset-form pull-right" style="display: none;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="input-group input-group-sm">
                                    <input type="password" name="password" class="form-control" placeholder="<%= __('New password') %>" minlength="8" required>
                                    <span class="input-group-btn"><button type="submit" class="btn btn-default"><%= __('Set') %></button></span>
                                </div>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            </div>
        </div>

        <p class="text-center text-muted" style="margin-top: 8px;"><%- __('Powered by %s', '<a href="https://github.com/hackmdio/codimd">CodiMD</a>') %></p>
    </div>

    <script nonce="<%= nonce %>">
      // respect the shared dark-mode preference (set on the dashboard / editor)
      try {
        if (window.localStorage.getItem('nightMode') === 'true' || document.cookie.indexOf('nightMode=true') !== -1) {
          document.body.classList.add('dash-night')
        }
      } catch (e) {}
      document.addEventListener('submit', function (e) {
        var msg = e.target.getAttribute('data-confirm')
        if (msg && !window.confirm(msg)) e.preventDefault()
      })
      document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('[data-reset-toggle]')
        if (!btn) return
        var form = document.getElementById(btn.getAttribute('data-reset-toggle'))
        if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none'
      })
    </script>
</body>

</html>
