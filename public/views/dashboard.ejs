<!DOCTYPE html>
<html lang="<%= getLocale() %>">

<head>
    <%- include('index/head') %>
    <style nonce="<%= nonce %>">
        body { background-color: #f7f7f9; color: #333; }
        .dash-wrap { max-width: 1100px; margin: 0 auto; padding: 24px 15px 60px; }
        .dash-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-bottom: 24px; }
        .dash-head .brand { font-size: 22px; font-weight: 600; }
        .dash-head .brand .fa { margin-right: 6px; }
        .dash-head .brand small { opacity: .55; font-weight: 400; }
        .dash-body { display: flex; flex-wrap: wrap; gap: 22px; }
        .dash-sidebar { flex: 0 0 240px; max-width: 240px; }
        .dash-main { flex: 1 1 600px; min-width: 0; }
        .dash-panel { margin-bottom: 22px; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
        .dash-panel .panel-heading { font-weight: 600; }
        .folder-list { list-style: none; margin: 0; padding: 0; }
        .folder-list > li > a { display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; color: #333; text-decoration: none; border-left: 3px solid transparent; }
        .folder-list > li > a:hover, .folder-list > li.active > a { background-color: #f2f2f5; border-left-color: #337ab7; }
        .folder-list .fa { margin-right: 6px; }
        .folder-count { font-size: 11px; opacity: .55; }
        .dash-toolbar { margin-bottom: 14px; }
        .dash-toolbar .form-group { margin-right: 6px; }
        #dashboard-notes { list-style: none; margin: 0; padding: 0; }
        .dash-note { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 6px; border-bottom: 1px solid #eee; }
        .dash-note-main { flex: 1 1 auto; min-width: 0; }
        .dash-note-link { color: #337ab7; text-decoration: none; font-weight: 500; }
        .dash-note-link .text { color: #333; }
        .dash-note-link:hover .text, .dash-note-link:hover { color: #337ab7; }
        .dash-note-link .fa { margin-right: 6px; opacity: .6; }
        .dash-note-actions { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
        .dash-note-actions .dash-move { width: auto; max-width: 160px; }
        .dash-note-tags { margin-top: 4px; }
        .dash-note-tags .tag-chip { display: inline-block; background: #eef2f6; color: #41607a; border-radius: 3px; font-size: 11px; padding: 1px 6px; margin: 2px 4px 0 0; }
        .dash-note-tags .tag-chip .tag-x { cursor: pointer; margin-left: 4px; opacity: .6; }
        .dash-note-spaces { margin-top: 4px; }
        .dash-note-spaces .dash-spaces-label { font-size: 11px; color: #777; margin-right: 4px; }
        .dash-note-spaces .dash-spaces-label .fa { margin-right: 3px; }
        .dash-note-spaces .space-chip { display: inline-block; background: #e8f5e9; color: #2e7d32; border: 1px solid #c8e6c9; border-radius: 3px; font-size: 11px; padding: 1px 6px; margin: 2px 4px 0 0; }
        .dash-note-spaces .space-chip .space-x { cursor: pointer; margin-left: 4px; opacity: .6; }
        .dash-shared-badge { display: inline-block; background: #2e7d32; color: #fff; border-radius: 3px; font-size: 10px; font-weight: 600; padding: 1px 6px; margin-left: 8px; vertical-align: middle; }
        .dash-shared-badge .fa { margin-right: 3px; }
        .dash-template-badge { display: inline-block; background: #f0ad4e; color: #fff; border-radius: 3px; font-size: 10px; font-weight: 600; padding: 1px 6px; margin-left: 8px; vertical-align: middle; }
        .dash-template-badge .fa { margin-right: 3px; }
        .dash-note .dash-template.active { color: #f0ad4e; }
        #template-list { list-style: none; margin: 0; padding: 0; }
        #template-list > li > a { display: flex; align-items: center; justify-content: space-between; padding: 8px 14px; color: #333; text-decoration: none; border-bottom: 1px solid #eee; }
        #template-list > li > a:hover { background-color: #f2f2f5; }
        #template-list .template-owner { font-size: 11px; color: #777; }
        #template-list .template-owner .fa { margin-right: 4px; opacity: .6; }
        .dash-note-actions .dash-space-add { width: auto; max-width: 160px; }
        .dash-note .dash-pin.pinned { color: #f0ad4e; }
        .dash-empty { text-align: center; padding: 50px 15px; color: #999; }
        .dash-empty .fa { font-size: 42px; opacity: .35; margin-bottom: 12px; }
        .dash-views { margin-bottom: 18px; }
        .dash-note-owner { font-size: 11px; color: #777; margin-top: 2px; }
        .dash-note-owner .fa { margin-right: 4px; opacity: .6; }
        .folder-list .space-actions { float: right; }
        .folder-list .space-actions .fa { margin-left: 6px; opacity: .5; cursor: pointer; }
        .folder-list .space-actions .fa:hover { opacity: 1; }
        #members-list { list-style: none; margin: 0; padding: 0; }
        #members-list > li { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 4px; border-bottom: 1px solid #eee; }
        #members-list .member-name { color: #333; }
        #members-list .member-name .fa { margin-right: 6px; opacity: .6; }
        #members-list .member-steward-badge { display: inline-block; background: #337ab7; color: #fff; border-radius: 3px; font-size: 10px; font-weight: 600; padding: 1px 6px; margin-left: 8px; vertical-align: middle; }
        #members-list .member-steward-badge .fa { margin-right: 3px; opacity: 1; }
        #members-list .member-actions { flex: 0 0 auto; }
        #members-list .member-actions .btn { margin-left: 4px; }
        .members-add { margin-top: 14px; }
        .members-add .form-control { max-width: 220px; }
    </style>
</head>

<body>
    <div class="dash-wrap">
        <div class="dash-head">
            <span class="brand"><i class="fa fa-file-text"></i> CodiMD <small>· <%= __('My Notes') %></small></span>
            <span>
                <i class="fa fa-user-circle-o"></i>&ensp;
                <a href="<%- serverURL %>/" class="btn btn-sm btn-default"><i class="fa fa-home"></i> <%= __('Home') %></a>
                <a href="<%- serverURL %>/logout" class="btn btn-sm btn-default"><i class="fa fa-sign-out"></i> <%= __('Sign Out') %></a>
            </span>
        </div>

        <% if (infoMessage && infoMessage.length > 0) { %>
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> <%= infoMessage %></div>
        <% } %>
        <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> <%= errorMessage %></div>
        <% } %>

        <div class="dash-views btn-group" role="group">
            <button type="button" class="btn btn-default active" id="dash-view-mynotes"><i class="fa fa-file-text-o"></i> <%= __('My Notes') %></button>
            <button type="button" class="btn btn-default" id="dash-view-browse"><i class="fa fa-share-alt"></i> <%= __('Browse') %></button>
        </div>

        <div class="dash-body" id="dashboard-mynotes-view">
            <div class="dash-sidebar">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-folder-o"></i> <%= __('Folders') %></div>
                    <ul class="folder-list" id="dashboard-folders">
                        <li class="active" data-folder="all">
                            <a href="#" data-folder="all"><span><i class="fa fa-list"></i> <%= __('All notes') %></span><span class="folder-count" data-count="all"></span></a>
                        </li>
                        <li data-folder="unfiled">
                            <a href="#" data-folder="unfiled"><span><i class="fa fa-inbox"></i> <%= __('Unfiled') %></span><span class="folder-count" data-count="unfiled"></span></a>
                        </li>
                        <!-- folders injected here by public/js/dashboard.js -->
                    </ul>
                    <div class="panel-body">
                        <form id="create-folder-form" class="form-inline">
                            <div class="input-group input-group-sm">
                                <input type="text" id="create-folder-name" class="form-control" placeholder="<%= __('New folder...') %>">
                                <span class="input-group-btn">
                                    <button type="submit" class="btn btn-default" title="<%= __('Create folder') %>"><i class="fa fa-plus"></i></button>
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="dash-main">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-sticky-note-o"></i> <%= __('Notes') %></div>
                    <div class="panel-body" id="dashboard-list">
                        <form class="form-inline dash-toolbar" id="dashboard-toolbar">
                            <div class="form-group" style="vertical-align: bottom;">
                                <select class="form-control" id="dashboard-tags" title="<%= __('Filter by tag') %>"><option value=""><%= __('All tags') %></option></select>
                            </div>
                            <div class="form-group">
                                <input class="search form-control" placeholder="<%= __('Search keyword...') %>">
                            </div>
                            <a href="#" class="sort btn btn-default" data-sort="text" title="<%= __('Sort by title') %>"><%= __('Title') %></a>
                            <a href="#" class="sort btn btn-default" data-sort="timestamp" title="<%= __('Sort by time') %>"><%= __('Time') %></a>
                            <a href="<%- serverURL %>/new" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> <%= __('New note') %></a>
                            <button type="button" id="dash-new-from-template" class="btn btn-default pull-right" style="margin-right: 6px;"><i class="fa fa-star"></i> <%= __('New from template') %></button>
                        </form>

                        <div class="dash-empty" id="dashboard-empty" style="display: none;">
                            <div><i class="fa fa-file-o"></i></div>
                            <h4><%= __('No notes yet') %></h4>
                            <a href="<%- serverURL %>/new" class="btn btn-primary"><i class="fa fa-plus"></i> <%= __('New note') %></a>
                        </div>

                        <ul id="dashboard-notes" class="list"></ul>
                        <ul class="pagination"></ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="dash-body" id="dashboard-browse-view" style="display: none;">
            <div class="dash-sidebar">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-share-alt"></i> <%= __('Spaces') %></div>
                    <ul class="folder-list" id="browse-spaces">
                        <li class="active" data-space="all">
                            <a href="#" data-space="all"><span><i class="fa fa-list"></i> <%= __('All shared') %></span><span class="folder-count" data-count="all"></span></a>
                        </li>
                        <!-- spaces injected here by public/js/dashboard.js -->
                    </ul>
                    <div class="dash-empty" id="browse-spaces-empty" style="display: none; padding: 20px 15px;">
                        <p class="text-muted"><%= __('No shared spaces yet. Create one to start organising shared notes.') %></p>
                    </div>
                    <div class="panel-body">
                        <form id="create-space-form" class="form-inline">
                            <div class="input-group input-group-sm">
                                <input type="text" id="create-space-name" class="form-control" placeholder="<%= __('New space...') %>">
                                <span class="input-group-btn">
                                    <button type="submit" class="btn btn-default" title="<%= __('Create space') %>"><i class="fa fa-plus"></i></button>
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="dash-main">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-share-alt"></i> <%= __('Shared notes') %></div>
                    <div class="panel-body" id="browse-list">
                        <form class="form-inline dash-toolbar" id="browse-toolbar" onsubmit="return false;">
                            <div class="form-group">
                                <input class="search form-control" placeholder="<%= __('Search keyword...') %>">
                            </div>
                            <a href="#" class="sort btn btn-default" data-sort="text" title="<%= __('Sort by title') %>"><%= __('Title') %></a>
                            <a href="#" class="sort btn btn-default" data-sort="timestamp" title="<%= __('Sort by time') %>"><%= __('Time') %></a>
                        </form>

                        <div class="dash-empty" id="browse-empty" style="display: none;">
                            <div><i class="fa fa-share-alt"></i></div>
                            <h4><%= __('No shared notes yet — open a note from My Notes and add it to a space.') %></h4>
                        </div>

                        <ul id="browse-notes" class="list"></ul>
                        <ul class="pagination"></ul>
                    </div>
                </div>
            </div>
        </div>

        <p class="text-center text-muted" style="margin-top: 8px;"><%- __('Powered by %s', '<a href="https://github.com/hackmdio/codimd">CodiMD</a>') %></p>
    </div>

    <div class="modal fade" id="template-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-star"></i> <%= __('New from template') %></h4>
                </div>
                <div class="modal-body" id="template-modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="members-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-users"></i> <%= __('Members') %> <small class="members-modal-space"></small></h4>
                </div>
                <div class="modal-body" id="members-modal-body"></div>
            </div>
        </div>
    </div>

    <script nonce="<%= nonce %>">
        window.dashboardUser = { id: '<%= userId %>', role: '<%= userRole %>' }
    </script>
    <% if(useCDN) { %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js" integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/velocity/1.5.2/velocity.min.js" integrity="sha256-1HqoI76JGKA17K0C0s9K8L/iy8PAC43KVLt1hRD/Ojc=" crossorigin="anonymous" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.4.0/js/bootstrap.min.js" integrity="sha256-kJrlY+s09+QoWjpkOrXXwhxeaoDz9FW5SaxF8I0DibQ=" crossorigin="anonymous" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/list.pagination.js/0.1.1/list.pagination.min.js" integrity="sha256-WwTza96H3BgcQTfEfxX7MFaFc/dZA0QrPRKDRLdFHJo=" crossorigin="anonymous" defer></script>
    <%- include('build/dashboard-scripts') %>
    <% } else { %>
    <%- include('build/dashboard-pack-scripts') %>
    <% } %>
</body>

</html>
