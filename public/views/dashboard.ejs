<!DOCTYPE html>
<html lang="<%= getLocale() %>">

<head>
    <%- include('index/head') %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,900;1,9..144,500&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style nonce="<%= nonce %>">
        :root {
            --paper: #f7f4ee; --paper-raised: #fffefb; --ink: #1d1b18; --ink-soft: #574f46; --ink-faint: #948b7d;
            --rule: #e6e0d4; --rule-strong: #d2c9b9; --accent: #c2412a; --accent-deep: #a2331f; --accent-tint: #f5e6e0;
            --sage: #3d6a4d; --sage-tint: #e7efe7; --ochre: #946614; --tag: #33506f; --tag-tint: #e6ecf3;
        }
        body { background-color: var(--paper); color: var(--ink); font-family: 'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size: 15.5px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
        ::selection { background: var(--accent-tint); }
        .dash-wrap { max-width: 1120px; margin: 0 auto; padding: 36px 24px 80px; }
        /* masthead */
        .dash-head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 0; }
        .dash-head .brand { font-family: 'Fraunces', Georgia, serif; font-weight: 900; font-size: clamp(28px, 4.4vw, 44px); line-height: .92; letter-spacing: -.015em; color: var(--ink); }
        .dash-head .brand .fa { color: var(--accent); margin-right: 4px; font-size: .78em; vertical-align: baseline; }
        .dash-head .brand small { display: block; font-family: 'Fraunces', Georgia, serif; font-style: italic; font-weight: 500; font-size: .4em; letter-spacing: 0; color: var(--ink-soft); margin-top: 6px; }
        .dash-head .head-tools .btn { color: var(--ink-soft); }
        .masthead-rule { height: 3px; background: var(--accent); margin: 16px 0 30px; border: 0; }
        /* layout */
        .dash-body { display: flex; flex-wrap: wrap; gap: 34px; }
        .dash-sidebar { flex: 0 0 230px; max-width: 230px; }
        .dash-main { flex: 1 1 600px; min-width: 0; }
        .dash-panel { margin-bottom: 26px; background: var(--paper-raised); border: 1px solid var(--rule); border-radius: 3px; box-shadow: none; }
        .dash-panel > .panel-heading { background: transparent; border: 0; border-bottom: 1px solid var(--rule); color: var(--ink-faint); font-weight: 600; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; padding: 13px 16px; }
        .dash-panel > .panel-heading .fa { color: var(--accent); }
        .dash-panel .panel-body { padding: 14px 16px; }
        /* folders / spaces list */
        .folder-list { list-style: none; margin: 0; padding: 6px 0; }
        .folder-list > li { position: relative; }
        .folder-list > li > a { display: flex; align-items: center; gap: 8px; padding: 9px 16px; color: var(--ink); text-decoration: none; border-left: 3px solid transparent; transition: background .15s ease, border-color .15s ease; }
        .folder-list > li > a:hover { background-color: var(--accent-tint); }
        .folder-list > li.active > a { background-color: var(--accent-tint); border-left-color: var(--accent); font-weight: 600; }
        .folder-list > li > a > span:first-child { display: inline-flex; align-items: center; min-width: 0; flex: 1 1 auto; }
        .folder-list .space-name, .folder-list .folder-name { min-width: 0; overflow-wrap: break-word; text-align: left; }
        .folder-list .fa { margin-right: 8px; color: var(--ink-faint); }
        .folder-list > li.active > a .fa { color: var(--accent); }
        .folder-count { flex: 0 0 auto; font-size: 11px; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
        /* management icons reveal on row hover, overlaying the count — keeps names roomy in the narrow sidebar */
        .folder-list .space-actions, .folder-list .folder-actions { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); display: inline-flex; align-items: center; gap: 11px; padding-left: 10px; background: var(--accent-tint); opacity: 0; pointer-events: none; transition: opacity .12s ease; }
        .folder-list .space-actions:empty, .folder-list .folder-actions:empty { display: none; }
        .folder-list > li:hover .space-actions, .folder-list > li:hover .folder-actions, .folder-list .space-actions:focus-within, .folder-list .folder-actions:focus-within { opacity: 1; pointer-events: auto; }
        .folder-list .space-actions .fa, .folder-list .folder-actions .fa { margin: 0; color: var(--ink-faint); cursor: pointer; }
        .folder-list .space-actions .fa:hover, .folder-list .folder-actions .fa:hover { color: var(--accent); }
        @media (hover: none) { .folder-list .space-actions, .folder-list .folder-actions { position: static; transform: none; opacity: 1; pointer-events: auto; background: transparent; padding-left: 0; margin-left: 4px; } }
        /* sidebar tag filter (private axis, alongside folders) */
        .dash-tags-panel .panel-body { padding: 12px 14px 14px; }
        .dash-tag-filter { display: flex; flex-wrap: wrap; gap: 6px; }
        .dash-tag-filter-chip { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 3px; font-size: 12px; font-weight: 500; color: var(--tag); background: var(--tag-tint); border: 1px solid transparent; text-decoration: none; transition: background .12s ease, border-color .12s ease, color .12s ease; }
        .dash-tag-filter-chip:hover { border-color: color-mix(in srgb, var(--tag) 35%, transparent); color: var(--tag); text-decoration: none; }
        .dash-tag-filter-chip.active { background: var(--tag); color: #fff; }
        .dash-tag-filter-chip .dash-tag-filter-count { font-size: 10px; opacity: .7; font-variant-numeric: tabular-nums; }
        .dash-tag-filter-chip[data-tag=""] { color: var(--ink-soft); background: transparent; border-color: var(--rule-strong); }
        .dash-tag-filter-chip[data-tag=""]:hover { color: var(--ink); border-color: var(--ink-faint); }
        .dash-tag-filter-chip[data-tag=""].active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
        .dash-tag-empty { font-size: 12px; color: var(--ink-faint); }
        /* toolbar + notes list */
        .dash-toolbar { margin-bottom: 6px; }
        .dash-toolbar .form-group { margin-right: 8px; }
        #dashboard-notes, #browse-notes { list-style: none; margin: 0; padding: 0; }
        #dashboard-notes, #browse-notes { display: block; }
        .dash-note { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 16px 6px; border-bottom: 1px solid var(--rule); transition: background .15s ease; }
        .dash-note:hover { background: color-mix(in srgb, var(--accent-tint) 45%, transparent); }
        .dash-note-main { flex: 1 1 auto; min-width: 0; }
        /* select mode: per-row checkboxes + bulk bar */
        .dash-note-check { display: none; }
        #dashboard-notes.selecting .dash-note-check { display: inline-block; flex: 0 0 auto; width: 15px; height: 15px; margin: 0 2px 0 0; cursor: pointer; accent-color: var(--accent); }
        #dashboard-notes.selecting .dash-note-actions { display: none; }
        #dashboard-notes.selecting .dash-note-time { opacity: .6; }
        #dashboard-notes.selecting .dash-note { cursor: pointer; }
        #dashboard-notes.selecting .dash-note.dash-checked { background: color-mix(in srgb, var(--accent-tint) 60%, transparent); }
        #dash-select-toggle.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
        .dash-bulk-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 12px; padding: 10px 12px; background: var(--accent-tint); border: 1px solid var(--rule-strong); border-radius: 4px; }
        .dash-bulk-all { margin: 0; font-weight: 600; font-size: 13px; color: var(--ink); display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
        .dash-bulk-all input { accent-color: var(--accent); }
        .dash-bulk-bar .dash-bulk-folder, .dash-bulk-bar .dash-bulk-space { width: auto; max-width: 150px; }
        .dash-bulk-bar .dash-bulk-tag { margin: 0; }
        .dash-bulk-bar .dash-bulk-tag-input { width: 100px; }
        .dash-bulk-bar .dash-bulk-clear { color: var(--ink-soft); margin-left: auto; }
        .dash-note-link { text-decoration: none; }
        .dash-note-link .text { font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 20px; line-height: 1.25; letter-spacing: -.011em; color: var(--ink); overflow-wrap: break-word; transition: color .15s ease; }
        .dash-note-link:hover .text { color: var(--accent); }
        .dash-note-link .fa { margin-right: 8px; color: var(--ink-faint); }
        .dash-note-actions { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
        /* compact one-line rows (My Notes + Browse); management/actions reveal on hover */
        #dashboard-notes .dash-note, #browse-notes .dash-note { padding: 10px 8px; gap: 12px; text-align: left; }
        #dashboard-notes .dash-note-main, #browse-notes .dash-note-main { display: flex; flex-wrap: wrap; align-items: center; gap: 5px 8px; min-width: 0; flex: 1 1 auto; }
        #dashboard-notes .dash-note-link, #browse-notes .dash-note-link { min-width: 0; max-width: 100%; flex: 0 1 auto; overflow: hidden; white-space: nowrap; }
        #dashboard-notes .dash-note-link .text, #browse-notes .dash-note-link .text { font-size: 17px; line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block; max-width: 100%; vertical-align: bottom; }
        #dashboard-notes .dash-shared-badge, #dashboard-notes .dash-template-badge { flex: 0 0 auto; margin-left: 0; }
        #dashboard-notes .dash-pin-badge { flex: 0 0 auto; color: var(--accent); font-size: 12.5px; line-height: 1; }
        #dashboard-notes .dash-pin-badge .fa { transform: rotate(20deg); }
        #dashboard-notes .dash-note-tags, #dashboard-notes .dash-note-spaces, #browse-notes .dash-note-spaces { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; margin-top: 0; flex: 0 1 auto; min-width: 0; }
        #dashboard-notes .dash-note-tags .dash-tag-chip, #dashboard-notes .dash-note-spaces .space-chip, #browse-notes .dash-note-spaces .space-chip { flex: 0 0 auto; max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        #dashboard-notes .dash-note-tags { margin-left: 2px; }
        #dashboard-notes .dash-note-tags:empty, #dashboard-notes .dash-note-spaces:empty, #browse-notes .dash-note-spaces:empty { display: none; }
        #dashboard-notes .dash-note-spaces .dash-spaces-label, #browse-notes .dash-note-spaces .dash-spaces-label { display: none; }
        #browse-notes .dash-note-owner { display: inline-flex; align-items: center; gap: 4px; flex: 0 0 auto; font-size: 12px; color: var(--ink-soft); }
        #browse-notes .dash-note-owner .fa { color: var(--ink-faint); }
        /* per-note time meta (edited · read), right-aligned before the actions */
        #dashboard-notes .dash-note-time, #browse-notes .dash-note-time { flex: 0 0 auto; margin-left: auto; display: inline-flex; align-items: center; gap: 12px; padding-left: 8px; font-size: 11px; color: var(--ink-faint); white-space: nowrap; font-variant-numeric: tabular-nums; }
        #dashboard-notes .dash-note-time .fa, #browse-notes .dash-note-time .fa { margin-right: 3px; opacity: .75; }
        #dashboard-notes .dash-note-time:empty, #browse-notes .dash-note-time:empty { display: none; }
        @media (max-width: 768px) { #dashboard-notes .dash-note-time, #browse-notes .dash-note-time { gap: 8px; font-size: 10px; } }
        #browse-notes .dash-note-owner:empty { display: none; }
        #dashboard-notes .dash-note-actions, #browse-notes .dash-note-actions { opacity: 0; transition: opacity .12s ease; }
        #dashboard-notes .dash-note:hover .dash-note-actions, #dashboard-notes .dash-note-actions:focus-within, #browse-notes .dash-note:hover .dash-note-actions, #browse-notes .dash-note-actions:focus-within { opacity: 1; }
        @media (hover: none) { #dashboard-notes .dash-note-actions, #browse-notes .dash-note-actions { opacity: 1; } }
        #dashboard-notes .dash-note-actions > .btn, #dashboard-notes .dash-menu-toggle, #browse-notes .dash-note-actions > .btn { color: var(--ink-soft); }
        /* ⋯ organize menu */
        .dash-menu { display: inline-block; }
        .dash-menu-panel { min-width: 236px; padding: 11px 12px 9px; background: var(--paper-raised); border: 1px solid var(--rule-strong); border-radius: 4px; box-shadow: 0 12px 34px rgba(34, 29, 23, .16); }
        .dash-menu-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
        .dash-menu-label { flex: 0 0 42px; font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); }
        .dash-menu-row .form-control { width: auto; flex: 1 1 auto; }
        .dash-menu-row .input-group { width: 100%; }
        .dash-menu-template { display: block; width: 100%; text-align: left; margin-top: 2px; }
        .dash-menu-template .fa { margin-right: 5px; }
        .dash-menu-section { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 9px; }
        .dash-menu-section .fa { color: var(--sage); margin-right: 5px; }
        .dash-menu-hint { font-weight: 500; letter-spacing: 0; text-transform: none; color: var(--ink-faint); }
        .dash-menu-divider { height: 1px; background: var(--rule); margin: 11px -12px; }
        /* meta + chips */
        .dash-note-owner { font-size: 11px; color: var(--ink-soft); margin-top: 4px; }
        .dash-note-owner .fa { margin-right: 5px; color: var(--ink-faint); }
        .dash-note-tags, .dash-note-spaces { margin-top: 6px; }
        .dash-note-tags .dash-tag-chip { display: inline-block; background: var(--tag-tint); color: var(--tag); border-radius: 2px; font-size: 11px; font-weight: 500; line-height: 1.5; text-transform: none; padding: 1px 7px; margin: 2px 5px 0 0; }
        .dash-note-tags .dash-tag-chip .dash-tag-remove { cursor: pointer; margin-left: 5px; color: inherit; opacity: .55; text-decoration: none; }
        .dash-note-tags .dash-tag-chip .dash-tag-remove:hover { opacity: 1; }
        .dash-note-spaces .dash-spaces-label { font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-faint); margin-right: 6px; }
        .dash-note-spaces .dash-spaces-label .fa { margin-right: 4px; }
        .dash-note-spaces .space-chip { display: inline-block; background: var(--sage-tint); color: var(--sage); border: 1px solid color-mix(in srgb, var(--sage) 25%, transparent); border-radius: 2px; font-size: 11px; font-weight: 500; padding: 1px 7px; margin: 2px 5px 0 0; }
        .dash-note-spaces .space-chip .space-x { cursor: pointer; margin-left: 5px; opacity: .55; }
        .dash-shared-badge { display: inline-block; background: var(--sage); color: var(--paper-raised); border-radius: 2px; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; margin-left: 9px; vertical-align: 2px; }
        .dash-shared-badge .fa { margin-right: 4px; }
        .dash-template-badge { display: inline-block; background: var(--ochre); color: var(--paper-raised); border-radius: 2px; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; margin-left: 9px; vertical-align: 2px; }
        .dash-template-badge .fa { margin-right: 4px; }
        .dash-note .dash-template.active { color: var(--ochre); }
        .dash-note .dash-pin.pinned { color: var(--accent); }
        /* buttons + inputs */
        .btn-default { background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 3px; transition: background .15s ease, color .15s ease, border-color .15s ease; }
        .btn-default:hover, .btn-default:focus { background: var(--accent-tint); color: var(--accent-deep); border-color: var(--accent); }
        .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; border-radius: 3px; }
        .btn-primary:hover, .btn-primary:focus { background: var(--accent-deep); border-color: var(--accent-deep); color: #fff; }
        .btn-success { background: var(--sage); border-color: var(--sage); }
        .form-control { background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 3px; box-shadow: none; }
        .form-control:focus { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-tint); }
        .form-control::placeholder { color: var(--ink-faint); }
        /* view toggle (segmented) */
        .dash-views { margin-bottom: 24px; }
        .dash-views.btn-group > .btn { background: var(--paper-raised); border-color: var(--rule-strong); color: var(--ink-soft); font-weight: 600; font-size: 14px; letter-spacing: .02em; padding: 7px 18px; }
        .dash-views.btn-group > .btn.active, .dash-views.btn-group > .btn:active { background: var(--ink); color: var(--paper); border-color: var(--ink); box-shadow: none; }
        /* pagination (editorial) */
        .pagination { margin: 20px 0 4px; }
        .pagination > li > a, .pagination > li > span { color: var(--ink-soft); background: var(--paper-raised); border-color: var(--rule-strong); border-radius: 2px !important; margin: 0 3px; font-weight: 600; font-size: 13px; min-width: 34px; text-align: center; }
        .pagination > li > a:hover, .pagination > li > span:hover { color: var(--accent); background: var(--accent-tint); border-color: var(--rule-strong); }
        .pagination > .active > a, .pagination > .active > a:hover, .pagination > .active > a:focus, .pagination > .active > span { background: var(--accent); border-color: var(--accent); color: #fff; }
        /* template / members lists */
        #template-list { list-style: none; margin: 0; padding: 0; }
        #template-list > li > a { display: flex; align-items: center; justify-content: space-between; padding: 11px 16px; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule); }
        #template-list > li > a:hover { background-color: var(--accent-tint); }
        #template-list .template-owner { font-size: 11px; color: var(--ink-soft); }
        #template-list .template-owner .fa { margin-right: 4px; color: var(--ink-faint); }
        #members-list { list-style: none; margin: 0; padding: 0; }
        #members-list > li { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 4px; border-bottom: 1px solid var(--rule); }
        #members-list .member-name { color: var(--ink); }
        #members-list .member-name .fa { margin-right: 7px; color: var(--ink-faint); }
        #members-list .member-steward-badge { display: inline-block; background: var(--accent); color: #fff; border-radius: 2px; font-size: 10px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 2px 7px; margin-left: 8px; vertical-align: middle; }
        #members-list .member-steward-badge .fa { margin-right: 3px; }
        #members-list .member-actions { flex: 0 0 auto; }
        #members-list .member-actions .btn { margin-left: 4px; }
        .members-add { margin-top: 16px; }
        .members-add .form-control { max-width: 220px; }
        /* empty state */
        .dash-empty { text-align: center; padding: 64px 20px; color: var(--ink-faint); }
        .dash-empty .fa { font-size: 40px; color: var(--rule-strong); margin-bottom: 14px; }
        .dash-empty h4 { font-family: 'Fraunces', Georgia, serif; color: var(--ink-soft); }
        /* links + modals */
        a { color: var(--accent); }
        a:hover { color: var(--accent-deep); }
        .modal-content { background: var(--paper-raised); color: var(--ink); border: 1px solid var(--rule-strong); border-radius: 4px; }
        .modal-header, .modal-footer { border-color: var(--rule); }
        .modal-title { font-family: 'Fraunces', Georgia, serif; font-weight: 600; }
        .modal-title .fa { color: var(--accent); }
        /* entrance motion (restrained) */
        @keyframes dashRise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
        .dash-head, .dash-views, .dash-sidebar, .dash-main { animation: dashRise .5s cubic-bezier(.22,.61,.36,1) both; }
        .dash-views { animation-delay: .05s; } .dash-sidebar { animation-delay: .1s; } .dash-main { animation-delay: .16s; }
        @media (prefers-reduced-motion: reduce) { *, .dash-head, .dash-views, .dash-sidebar, .dash-main { animation: none !important; transition: none !important; } }
        /* --- responsive: stack columns + note rows on small screens --- */
        @media (max-width: 768px) {
            .dash-wrap { padding: 16px 10px 50px; }
            .dash-head { margin-bottom: 18px; }
            .dash-head .brand { font-size: 18px; }
            .dash-sidebar { flex: 1 1 100%; max-width: none; }
            .dash-main { flex: 1 1 100%; }
            .dash-note { flex-direction: column; align-items: stretch; gap: 8px; }
            .dash-note-actions { flex-wrap: wrap; }
            .dash-note-actions .dash-move,
            .dash-note-actions .dash-space-add,
            .dash-note-actions .dash-add-tag { flex: 1 1 130px; max-width: none; }
            .dash-note-actions .dash-add-tag .input-group { width: 100%; }
            .dash-toolbar .form-group { display: block; margin: 0 0 8px; }
            .dash-toolbar .form-group .form-control { width: 100%; }
            #browse-notes { display: block; }
            .members-add .form-control { max-width: none; width: 100%; }
            #members-list > li { flex-wrap: wrap; gap: 6px; }
            .modal-dialog { margin: 10px; }
        }
        @media (max-width: 480px) {
            .dash-head .brand small { display: none; }
            .dash-views { display: flex; }
            .dash-views .btn { flex: 1 1 50%; }
        }
        /* --- dark mode: just override the tokens (shares the editor's nightMode preference) --- */
        body.dash-night {
            --paper: #1b1714; --paper-raised: #241f1a; --ink: #efe7da; --ink-soft: #b6ac9b; --ink-faint: #8a7f6d;
            --rule: #352e26; --rule-strong: #473e33; --accent: #e06a50; --accent-deep: #cc5a40; --accent-tint: #2c211b;
            --sage: #7fb88f; --sage-tint: #1f2c23; --ochre: #d6a24e; --tag: #9db8d6; --tag-tint: #1f2733;
            background-color: var(--paper); color: var(--ink);
        }
        body.dash-night .btn-primary,
        body.dash-night .dash-views.btn-group > .btn.active { color: #1b1714; }
        body.dash-night .close { color: var(--ink-soft); text-shadow: none; opacity: .8; }
        body.dash-night .alert-success { background: var(--sage-tint); border-color: color-mix(in srgb, var(--sage) 30%, transparent); color: var(--sage); }
        body.dash-night .alert-danger { background: #3a2326; border-color: #5a363a; color: #e6a6ad; }
    </style>
</head>

<body>
    <div class="dash-wrap">
        <div class="dash-head">
            <span class="brand"><i class="fa fa-file-text"></i>CodiMD <small><%= __('My Notes') %></small></span>
            <span class="head-tools">
                <button type="button" class="btn btn-sm btn-default dash-night-toggle" title="<%= __('Toggle dark mode') %>"><i class="fa fa-moon-o"></i></button>
                <a href="<%- serverURL %>/" class="btn btn-sm btn-default"><i class="fa fa-home"></i> <%= __('Home') %></a>
                <a href="<%- serverURL %>/logout" class="btn btn-sm btn-default"><i class="fa fa-sign-out"></i> <%= __('Sign Out') %></a>
            </span>
        </div>
        <hr class="masthead-rule">

        <% if (infoMessage && infoMessage.length > 0) { %>
        <div class="alert alert-success"><i class="fa fa-check-circle"></i> <%= infoMessage %></div>
        <% } %>
        <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> <%= errorMessage %></div>
        <% } %>

        <div class="dash-views btn-group" role="group">
            <button type="button" class="btn btn-default active" id="dash-view-mynotes"><i class="fa fa-file-text-o"></i> <%= __('My Notes') %></button>
            <button type="button" class="btn btn-default" id="dash-view-browse"><i class="fa fa-share-alt"></i> <%= __('Browse') %></button>
        </div>

        <div class="dash-body" id="dashboard-mynotes-view">
            <div class="dash-sidebar">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-folder-o"></i> <%= __('Folders') %></div>
                    <ul class="folder-list" id="dashboard-folders">
                        <li class="active" data-folder="all">
                            <a href="#" data-folder="all"><span><i class="fa fa-list"></i> <%= __('All notes') %></span><span class="folder-count" data-count="all"></span></a>
                        </li>
                        <li data-folder="unfiled">
                            <a href="#" data-folder="unfiled"><span><i class="fa fa-inbox"></i> <%= __('Unfiled') %></span><span class="folder-count" data-count="unfiled"></span></a>
                        </li>
                        <!-- folders injected here by public/js/dashboard.js -->
                    </ul>
                    <div class="panel-body">
                        <form id="create-folder-form" class="form-inline">
                            <div class="input-group input-group-sm">
                                <input type="text" id="create-folder-name" class="form-control" placeholder="<%= __('New folder...') %>">
                                <span class="input-group-btn">
                                    <button type="submit" class="btn btn-default" title="<%= __('Create folder') %>"><i class="fa fa-plus"></i></button>
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="panel panel-default dash-panel dash-tags-panel">
                    <div class="panel-heading"><i class="fa fa-tag"></i> <%= __('Tags') %></div>
                    <div class="panel-body">
                        <div class="dash-tag-filter" id="dashboard-tag-filter">
                            <!-- tag filter chips injected by public/js/dashboard.js -->
                        </div>
                    </div>
                </div>
            </div>

            <div class="dash-main">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-sticky-note-o"></i> <%= __('Notes') %></div>
                    <div class="panel-body" id="dashboard-list">
                        <form class="form-inline dash-toolbar" id="dashboard-toolbar">
                            <div class="form-group">
                                <input class="dash-search form-control" placeholder="<%= __('Search notes & content...') %>">
                            </div>
                            <div class="form-group">
                                <select class="form-control" id="dashboard-sort" title="<%= __('Sort') %>">
                                    <option value="edited"><%= __('Last edited') %></option>
                                    <option value="opened"><%= __('Last opened') %></option>
                                    <option value="title"><%= __('Title A–Z') %></option>
                                    <option value="created"><%= __('Recently created') %></option>
                                </select>
                            </div>
                            <button type="button" id="dash-select-toggle" class="btn btn-default" title="<%= __('Select notes') %>"><i class="fa fa-check-square-o"></i> <%= __('Select') %></button>
                            <a href="<%- serverURL %>/new" class="btn btn-primary pull-right"><i class="fa fa-plus"></i> <%= __('New note') %></a>
                            <button type="button" id="dash-new-from-template" class="btn btn-default pull-right" style="margin-right: 6px;"><i class="fa fa-star"></i> <%= __('New from template') %></button>
                        </form>

                        <div class="dash-bulk-bar" id="dashboard-bulk-bar" style="display: none;">
                            <label class="dash-bulk-all"><input type="checkbox" id="dashboard-select-all"> <span id="dashboard-bulk-count">0 selected</span></label>
                            <select class="form-control input-sm dash-bulk-folder" title="<%= __('Move to folder') %>"></select>
                            <select class="form-control input-sm dash-bulk-space" title="<%= __('Add to space') %>"></select>
                            <form class="dash-bulk-tag form-inline">
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control dash-bulk-tag-input" placeholder="<%= __('Add tag') %>">
                                    <span class="input-group-btn"><button type="submit" class="btn btn-default"><i class="fa fa-plus"></i></button></span>
                                </div>
                            </form>
                            <button type="button" class="btn btn-xs btn-default dash-bulk-pin" data-pin="1" title="<%= __('Pin') %>"><i class="fa fa-thumb-tack"></i></button>
                            <button type="button" class="btn btn-xs btn-default dash-bulk-pin" data-pin="0" title="<%= __('Unpin') %>"><i class="fa fa-thumb-tack fa-rotate-90"></i></button>
                            <button type="button" class="btn btn-xs btn-danger dash-bulk-delete"><i class="fa fa-trash"></i> <%= __('Delete') %></button>
                            <button type="button" class="btn btn-xs btn-link dash-bulk-clear"><%= __('Clear') %></button>
                        </div>

                        <div class="dash-empty" id="dashboard-empty" style="display: none;">
                            <div><i class="fa fa-file-o"></i></div>
                            <h4><%= __('No notes yet') %></h4>
                            <a href="<%- serverURL %>/new" class="btn btn-primary"><i class="fa fa-plus"></i> <%= __('New note') %></a>
                        </div>

                        <ul id="dashboard-notes" class="list"></ul>
                        <ul class="pagination"></ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="dash-body" id="dashboard-browse-view" style="display: none;">
            <div class="dash-sidebar">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-share-alt"></i> <%= __('Spaces') %></div>
                    <ul class="folder-list" id="browse-spaces">
                        <li class="active" data-space="all">
                            <a href="#" data-space="all"><span><i class="fa fa-list"></i> <%= __('All shared') %></span><span class="folder-count" data-count="all"></span></a>
                        </li>
                        <!-- spaces injected here by public/js/dashboard.js -->
                    </ul>
                    <div class="dash-empty" id="browse-spaces-empty" style="display: none; padding: 20px 15px;">
                        <p class="text-muted"><%= __('No shared spaces yet. Create one to start organising shared notes.') %></p>
                    </div>
                    <div class="panel-body">
                        <form id="create-space-form" class="form-inline">
                            <div class="input-group input-group-sm">
                                <input type="text" id="create-space-name" class="form-control" placeholder="<%= __('New space...') %>">
                                <span class="input-group-btn">
                                    <button type="submit" class="btn btn-default" title="<%= __('Create space') %>"><i class="fa fa-plus"></i></button>
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="dash-main">
                <div class="panel panel-default dash-panel">
                    <div class="panel-heading"><i class="fa fa-share-alt"></i> <%= __('Shared notes') %></div>
                    <div class="panel-body" id="browse-list">
                        <form class="form-inline dash-toolbar" id="browse-toolbar" onsubmit="return false;">
                            <div class="form-group">
                                <input class="dash-search form-control" placeholder="<%= __('Search notes & content...') %>">
                            </div>
                            <a href="#" class="sort btn btn-default" data-sort="text" title="<%= __('Sort by title') %>"><%= __('Title') %></a>
                            <a href="#" class="sort btn btn-default" data-sort="timestamp" title="<%= __('Sort by time') %>"><%= __('Time') %></a>
                        </form>

                        <div class="dash-empty" id="browse-empty" style="display: none;">
                            <div><i class="fa fa-share-alt"></i></div>
                            <h4><%= __('No shared notes yet — open a note from My Notes and add it to a space.') %></h4>
                        </div>

                        <ul id="browse-notes" class="list"></ul>
                        <ul class="pagination"></ul>
                    </div>
                </div>
            </div>
        </div>

        <p class="text-center text-muted" style="margin-top: 8px;"><%- __('Powered by %s', '<a href="https://github.com/hackmdio/codimd">CodiMD</a>') %></p>
    </div>

    <div class="modal fade" id="template-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-star"></i> <%= __('New from template') %></h4>
                </div>
                <div class="modal-body" id="template-modal-body"></div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="members-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"><i class="fa fa-users"></i> <%= __('Members') %> <small class="members-modal-space"></small></h4>
                </div>
                <div class="modal-body" id="members-modal-body"></div>
            </div>
        </div>
    </div>

    <script nonce="<%= nonce %>">
        window.dashboardUser = { id: '<%= userId %>', role: '<%= userRole %>' }
    </script>
    <% if(useCDN) { %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js" integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/velocity/1.5.2/velocity.min.js" integrity="sha256-1HqoI76JGKA17K0C0s9K8L/iy8PAC43KVLt1hRD/Ojc=" crossorigin="anonymous" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/3.4.0/js/bootstrap.min.js" integrity="sha256-kJrlY+s09+QoWjpkOrXXwhxeaoDz9FW5SaxF8I0DibQ=" crossorigin="anonymous" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/list.pagination.js/0.1.1/list.pagination.min.js" integrity="sha256-WwTza96H3BgcQTfEfxX7MFaFc/dZA0QrPRKDRLdFHJo=" crossorigin="anonymous" defer></script>
    <%- include('build/dashboard-scripts') %>
    <% } else { %>
    <%- include('build/dashboard-pack-scripts') %>
    <% } %>
</body>

</html>
